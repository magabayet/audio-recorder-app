rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Por ahora permitir lectura/escritura sin auth (fase inicial)
    // TODO: Agregar Firebase Auth y restringir por usuario
    match /recordings/{allPaths=**} {
      allow read, write: if true;
    }
    match /transcriptions/{allPaths=**} {
      allow read, write: if true;
    }
  }
}
